NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/services-mall
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
HOLD_MINUTES=10

# mock = simulated payments (development only), sandbox, production
MPESA_ENV=mock
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TXN_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_SECRET=change-me-change-me

# Africa's Talking SMS (leave empty to log messages instead of sending)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Used by npm run seed
SEED_ADMIN_PHONE=0700000000
SEED_ADMIN_PASSWORD=ChangeThisNow123
SEED_REGION_NAME=Local area

# Image uploads (Cloudinary). Leave empty to disable uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Days a completed booking waits before it can be paid out (time to raise a dispute)
PAYOUT_HOLD_DAYS=2
